{
  "name": "@gimlet-works/desktop",
  "productName": "Gimlet Works",
  "desktopName": "gimlet-works-desktop.desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Gimlet Works desktop workbench",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run build:ui && npm run electron:start",
    "build": "npm run build:ui && npm run electron:build",
    "build:ui": "npm run build --prefix ../.. --workspace @gimlet-works/core && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:ui": "vite",
    "electron:build": "tsc -p electron",
    "electron:start": "npm run electron:build && electron .",
    "package": "npm run build && electron-builder",
    "icon": "electron ../../scripts/make-icon.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@gimlet-works/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "dev.gimletworks.desktop",
    "productName": "Gimlet Works",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Gimlet Works contributors",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "deb": {
      "packageName": "gimlet-works-desktop",
      "fpm": [
        "--replaces=gimlet-eye",
        "--conflicts=gimlet-eye",
        "--provides=gimlet-eye"
      ]
    },
    "nsis": {
      "guid": "38f02069-fb9a-59a7-9e5c-f022bf2bf607"
    },
    "executableName": "gimlet-works-desktop",
    "artifactName": "gimlet-works-desktop-${version}-${arch}.${ext}"
  },
  "author": "Gimlet Works contributors",
  "homepage": "https://github.com/James-HoneyBadger/GimletWorks"
}
