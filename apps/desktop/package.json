{
  "name": "@gimlet-eye/desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Gimlet Eye desktop workbench",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run build:ui && npm run electron:start",
    "build": "npm run build:ui && npm run electron:build",
    "build:ui": "npm run build --prefix ../.. --workspace @gimlet-eye/core && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:ui": "vite",
    "electron:build": "tsc -p electron",
    "electron:start": "npm run electron:build && electron .",
    "package": "npm run build && electron-builder",
    "icon": "electron ../../scripts/make-icon.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@gimlet-eye/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "dev.gimleteye.desktop",
    "productName": "Gimlet Eye",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Gimlet Eye contributors"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "executableName": "gimlet-eye",
    "artifactName": "gimlet-eye-${version}-${arch}.${ext}"
  },
  "author": "Gimlet Eye contributors",
  "homepage": "https://github.com/James-HoneyBadger/GimletEye"
}
