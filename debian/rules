#!/usr/bin/make -f
# One build: TypeScript, shipped as plain JavaScript on the system Node. Debhelper
# runs it and then calls the shared staging script, which is also what the rpm and
# Arch recipes call — one definition of what the package contains.

%:
	dh $@

override_dh_auto_build:
	npm ci
	npm run build

override_dh_auto_test:
	# The suite is run in CI on every commit; rebuilding it here would double
	# the package build time for results that are already known.
	true

# The main package owns the payload; debhelper builds the transitional package.
override_dh_auto_install:
	./scripts/stage-package.sh debian/gimlet-works

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_clean:
	rm -rf packages/core/dist packages/engine/dist packages/cli/dist apps/desktop/dist
