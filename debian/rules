#!/usr/bin/make -f
# The engine is a cargo build; the command line is a TypeScript build that ships
# as plain JavaScript. Debhelper runs the two builds and then calls the shared
# staging script, which is also what the rpm and Arch recipes call — one
# definition of what the package contains.

export CARGO_INCREMENTAL=0
export RUSTFLAGS=--remap-path-prefix=$(CURDIR)=.

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked -p gimlet-eye-sidecar
	npm ci
	npm run build

override_dh_auto_test:
	# The suite is run in CI on every commit; rebuilding it here would double
	# the package build time for results that are already known.
	true

# One binary package, so the build root is the package root.
override_dh_auto_install:
	./scripts/stage-package.sh debian/gimlet

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_clean:
	cargo clean || true
	rm -rf packages/core/dist packages/cli/dist apps/desktop/dist
