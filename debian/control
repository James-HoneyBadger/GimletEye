# A distribution build with a rustc at or above the workspace `rust-version`
# satisfies this. Building on an older archive is why scripts/rehearse-upgrade.sh
# installs rustup and passes `-d`.
Build-Depends: debhelper-compat (= 13), cargo, rustc
Standards-Version: 4.6.2
Homepage: https://github.com/James-HoneyBadger/GimletEye
Vcs-Git: https://github.com/James-HoneyBadger/GimletEye.git
Rules-Requires-Root: no

Package: gimlet
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Recommends: perl
Description: local workbench for system, crypto, and metadata tasks
 One tool registry, one report format, one configuration file, one audit trail,
 and one interface for system administration, file encryption and signing, and
 metadata removal.
 .
 Everything runs locally: no network calls, no telemetry, no auto-update. The
 HTTP API binds loopback only and requires a per-installation token.
