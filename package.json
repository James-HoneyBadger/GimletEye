{
  "name": "gimlet-eye",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gimlet Eye — desktop workbench and command line for system, crypto, and metadata tasks",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @gimlet-eye/core -w @gimlet-eye/engine -w @gimlet-eye/cli",
    "build:desktop": "npm run build -w @gimlet-eye/desktop",
    "typecheck": "tsc -b packages/core packages/engine packages/cli && npm run typecheck -w @gimlet-eye/desktop",
    "test": "vitest run",
    "cli": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
