# Arch packaging for Gimlet Eye.
#
# The version here is checked against package.json by scripts/check-packaging.sh,
# so a release cannot ship a PKGBUILD that names a different version than the
# CLI it builds.
pkgname=gimlet-eye-toolkit
pkgver=0.7.0
pkgrel=1
pkgdesc="Local workbench for system, crypto, and metadata tasks"
arch=('x86_64' 'aarch64')
url="https://github.com/James-HoneyBadger/GimletEye"
license=('MIT')
depends=('gcc-libs' 'nodejs>=20')
makedepends=('cargo' 'rust' 'npm')
optdepends=('gnupg: OpenPGP interop (crypto.gpg-*)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    export CARGO_INCREMENTAL=0
    export RUSTFLAGS="--remap-path-prefix=$srcdir/$pkgname-$pkgver=."
    cargo build --release --locked -p gimlet-eye-sidecar
    npm ci
    npm run build
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/gimlet-sidecar "$pkgdir/usr/lib/gimlet/gimlet-sidecar"
    cp -r packages/core/dist "$pkgdir/usr/lib/gimlet/core"
    cp -r packages/cli/dist "$pkgdir/usr/lib/gimlet/cli"
    cp -r packages/cli/bin "$pkgdir/usr/lib/gimlet/bin"
    install -d "$pkgdir/usr/lib/gimlet/node_modules/@gimlet-eye"
    cp -r node_modules/smol-toml "$pkgdir/usr/lib/gimlet/node_modules/"
    ln -s ../../core "$pkgdir/usr/lib/gimlet/node_modules/@gimlet-eye/core"
    install -d "$pkgdir/usr/bin"
    ln -s ../lib/gimlet/bin/gimlet "$pkgdir/usr/bin/gimlet"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm644 docs/CONTAINER.md "$pkgdir/usr/share/doc/$pkgname/CONTAINER.md"
    install -Dm644 docs/COMPATIBILITY.md "$pkgdir/usr/share/doc/$pkgname/COMPATIBILITY.md"
}
