{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gimleteye.dev/schema/manifest-1.json",
  "title": "Gimlet Works tool manifest",
  "description": "What a tool declares about itself. The desktop builds its forms from this, and the CLI resolves tool ids against it.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "dataFieldSpec": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/dataSpec" }
      ]
    },
    "dataFieldMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/dataFieldSpec" }
    },
    "dataSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "required"],
          "properties": {
            "shape": { "const": "object" },
            "required": { "$ref": "#/definitions/dataFieldMap" },
            "optional": { "$ref": "#/definitions/dataFieldMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape"],
          "properties": {
            "shape": { "const": "array" },
            "row": { "$ref": "#/definitions/dataFieldMap" },
            "items": { "$ref": "#/definitions/dataFieldSpec" }
          }
        }
      ]
    }
  },
  "required": ["id", "title", "summary", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Category-qualified, stable, and part of the public API."
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["sysadmin", "crypto", "privacy", "forensics", "automation", "developer"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["fs:read", "fs:write", "process:exec", "network", "secrets", "system"] }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "integer", "boolean", "path", "enum"] },
          "required": { "type": "boolean" },
          "default": {},
          "help": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Required when type is enum."
          }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "data": {
      "description": "The declared shape of Report.data, checked when a report is returned.",
      "$ref": "#/definitions/dataSpec"
    },
    "mutates": { "type": "boolean" },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["linux", "macos", "windows"] }
    }
  }
}
