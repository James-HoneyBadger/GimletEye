# Rust
/target/
**/target/
*.rs.bk

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Playwright: traces, videos, and the HTML report from a failed run
apps/desktop/test-results/
apps/desktop/playwright-report/

# Fuzz working state: crash reproducers and the corpus libFuzzer grows during a
# run. The committed starting points live in crates/scrub/fuzz/seeds/.
crates/scrub/fuzz/artifacts/
crates/scrub/fuzz/corpus/
# A soak stages its rows here and appends them to the ledger when it finishes, so
# the file is only ever half-written state.
fuzz/*.tmp

# Runtime state
/.gimlet/
# Exported key material: `crypto.key-export secret=true` writes one of these, and
# a private key belongs in a keystore or on a token, never in a commit.
*.key
*.hbzf
*.hbzf.tmp

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Electron shell output, and the installers it produces
apps/desktop/electron/dist/
apps/desktop/release/
# The installer icon is rendered from the UI tokens by scripts/make-icon.mjs, so
# it is a build output rather than a checked-in binary.
apps/desktop/build/
